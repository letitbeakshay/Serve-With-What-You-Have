// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FormStatus {
  OPEN
  CLOSED
}

enum RegistrationStatus {
  YES
  NO
  IN_PROCESS
}

enum ResponseStatus {
  NEW
  CONTACTED
  ACTIVE
  PAUSED
  DECLINED
}

// A form is a named, shareable link. Every form uses the same v1 field set today.
// fieldSetVersion points at the config in lib/field-config/ so a second field
// set can be introduced later without touching this table.
model Form {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  status          FormStatus @default(OPEN)
  closedMessage   String?
  fieldSetVersion String     @default("v1")

  responses         Response[]
  simpleResponses   SimpleResponse[]
  referralResponses ReferralResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// One submission from one organisation. Named columns cover everything the
// admin panel filters, searches, or shows on a card. rawAnswers keeps a full
// snapshot of the submitted payload as a safety net against config drift.
model Response {
  id     String @id @default(cuid())
  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  // Section 1: Basic identity
  orgName      String
  orgType      String // code from field config, e.g. "orphanage_childrens_home"
  orgTypeOther String?

  // Section 2: Registration and location
  isRegistered        RegistrationStatus
  registrationNumber  String?
  yearStarted         Int?
  city                String
  state               String
  pinCode             String
  fullAddress         String
  mapsLink            String?

  // Section 3: Contact
  contactName      String
  contactRole      String
  phoneCountryCode String  @default("+91")
  phone            String
  altPhone         String?
  email            String?

  // Section 4: Scale
  // Shape: { "under_2": { male: number, female: number }, "2_to_5": {...}, ... }
  headcounts     Json
  whoServe       String[] // codes from field config
  whoServeOther  String?

  // Section 5: What they need
  supportOffered      String[] // codes from field config, at least one required
  supportOfferedOther String?
  mostNeeded          String   // single code, must be one of supportOffered (or "other")
  volunteerHelp        String[]
  volunteerHelpOther   String?

  // Presence and proof
  website     String?
  facebook    String?
  instagram   String?
  youtube     String?

  additionalNotes String?

  // Declarations. The exact wording per version lives in lib/field-config, which
  // is source controlled, so version + timestamp is enough to reconstruct consent.
  declarationsVersion    String
  declarationsAcceptedAt DateTime

  // Internal only. Never shown to the organisation.
  status         ResponseStatus @default(NEW)
  internalNotes  String?
  contactedBy    String?
  lastContactedAt DateTime?

  rawAnswers Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formId])
  @@index([status])
  @@index([city])
  @@index([state])
  @@index([orgType])
  @@index([createdAt])
}

// One submission to the simplified v2 onboarding form: name, phone,
// association name, a free-text location, and how they heard about us.
// The detailed Response/v1 field set above is kept for a future
// "upgrade" of the onboarding flow, not deleted.
model SimpleResponse {
  id     String @id @default(cuid())
  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  contactName      String
  phoneCountryCode String @default("+91")
  phone            String
  orgName          String
  location         String
  referralSource   String

  createdAt DateTime @default(now())

  @@index([formId])
  @@index([createdAt])
}

// One submission on the "know a home? share it with us" form -- someone
// pointing us at an orphanage/home rather than onboarding their own.
// referrerName is optional: they can tell us about a home anonymously.
model ReferralResponse {
  id     String @id @default(cuid())
  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  referrerName String?
  orgName      String
  orgPhone     String
  location     String

  createdAt DateTime @default(now())

  @@index([formId])
  @@index([createdAt])
}

// One "show interest" popup submission from the homepage's Ways to serve
// section, for the ways that aren't live yet (skills, time, refer-a-need).
// Not tied to a Form -- this is a single site-wide interest capture, not a
// shareable link.
model InterestResponse {
  id       String @id @default(cuid())
  category String // "skill" | "time" | "refer"

  name    String
  phone   String
  email   String
  message String

  createdAt DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

// One "book a free pickup" popup submission from the New Life to Old Clothes
// page. Captured before we send the person on to WhatsApp, so we know how
// many people click through even if they never send the WhatsApp message.
model PickupInterestResponse {
  id String @id @default(cuid())

  name  String
  phone String

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Manually logged by the admin after collecting clothes from a donor -- there
// is no public form for this, it's just a record of who gave what and when.
// The person, identified by phone number, across every kind of serving --
// not just clothes. One Donor can have many ClothDonation rows (and, later,
// other serving types) if they give more than once.
model Donor {
  id String @id @default(cuid())

  // The ID that follows this person across every donation, read out loud or
  // written on a bag -- distinct from a single ClothDonation's own
  // donorNumber, which identifies that one drop-off, not the person. Null
  // only for the one canonical Anonymous donor, which isn't numbered at all.
  donorNumber Int? @unique @default(autoincrement())

  // Normalized to digits only (see lib/normalize-phone.ts) so "93459 20202"
  // and "9345920202" match as the same person. Null for the Anonymous donor,
  // who by definition has none on file.
  phone String? @unique
  name  String
  email String?

  // True for exactly one row: the shared "Anonymous" donor every donation
  // with no known giver gets attached to, rather than inventing a fake phone
  // number for each one.
  isAnonymous Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clothDonations ClothDonation[]

  @@index([isAnonymous])
}

model ClothDonation {
  id String @id @default(cuid())

  // A short, human-friendly number (#1, #2, ...) volunteers and the admin
  // can read out loud or write on a bag -- the cuid id is not meant for that.
  // Identifies this donation event, not the person (see Donor.donorNumber
  // for that) -- the same donor can have several of these.
  donorNumber Int @unique @default(autoincrement())

  // The canonical person this donation belongs to, matched by phone number.
  // Nullable only because it's backfilled onto rows that predate this field.
  donor   Donor?  @relation(fields: [donorId], references: [id])
  donorId String?

  donorName String
  phone     String
  email     String?
  donatedAt DateTime

  // Whether the clothes arrived already washed. true = washed, false =
  // unwashed, null = "don't know" (whoever logged it genuinely wasn't sure).
  washed Boolean?

  collectionPoint String?
  location        String?

  createdAt DateTime @default(now())

  items DonationItem[]

  @@index([donatedAt])
  @@index([donorId])
}

enum DonationGender {
  MALE
  FEMALE
  GENERAL // items with no gender/age split: bedsheets, blankets, towels...
}

enum DonationAgeCategory {
  ADULT
  TEEN
  CHILD
}

// One garment line-item within a donation, logged by a volunteer through the
// /donation-entry mobile flow: pick the donor, then gender, then (unless
// GENERAL) age category, then garment type and how many.
// A volunteer, identified by phone number (same pattern as Donor) so the
// same person logging items on different days or devices is still one
// person, with one ID -- not just a free-text name with no identity behind
// it.
model Volunteer {
  id String @id @default(cuid())

  // The ID that follows this person across every entry they log.
  volunteerNumber Int @unique @default(autoincrement())

  // Normalized to digits only (see lib/normalize-phone.ts).
  phone String @unique
  name  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items DonationItem[]
}

model DonationItem {
  id String @id @default(cuid())

  donation   ClothDonation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  donationId String

  // The free-text name typed at the gate -- kept as-is for history even
  // where volunteerId below can't be resolved (entries logged before phone
  // numbers were captured).
  volunteerName String

  volunteer   Volunteer? @relation(fields: [volunteerId], references: [id])
  volunteerId String?

  gender      DonationGender
  ageCategory DonationAgeCategory?
  garmentType String
  quantity    Int

  createdAt DateTime @default(now())

  @@index([donationId])
  @@index([createdAt])
  @@index([volunteerId])
}

// A published story on /stories/[slug]. Admin fills in title, tags, banner
// and pastes bodyHtml directly; everything else is optional and simply
// doesn't render when left blank.
model Story {
  id     String @id @default(cuid())
  slug   String @unique

  title  String
  tags   String[]

  heroImagePath   String
  heroImageWidth  Int
  heroImageHeight Int
  heroCaption     String?

  standfirst     String?
  authorName     String   @default("Serve With What You Have")
  authorInitials String   @default("SW")
  publishedAt    DateTime @default(now())

  bodyHtml String // sanitized on write, rendered raw inside the article's read column

  facts      Json? // [{ value, label }, ...] (exactly 3 when set)
  gave       Json? // { label, subtext, squares: ("money"|"given"|"unused")[9], primaryTag }
  ctaHeading String?
  ctaText    String?

  relatedSlugs String[] @default([])

  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, publishedAt])
}

// Singleton row holding PIN lockout state for the single shared admin PIN.
// One person, one PIN, so a global counter is enough, no per-user tracking.
model AdminAuthState {
  id             Int       @id @default(1)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
}

// A teammate the owner has given admin access to. The owner sets the first
// password; mustResetPassword forces them to choose their own on first login.
// The owner themself still logs in with the PIN and has no row here.
model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  mustResetPassword Boolean @default(true)

  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
